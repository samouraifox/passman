#!/bin/bash
# passman -- a password manager built on age and wl-clipboard.
#
set -euo pipefail

STORE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/passman"  #Setting the storage directory variable
STORE="$STORE_DIR/store.age"                               # Setting the storage file variable 
CLIP_SECONDS=30                                            #Setting the time a password stays in the wl-clipboard
KEY="$STORE_DIR/key.age"
RECIPIENT="$STORE_DIR/recipient.txt"
CACHE_SECONDS=600
KEYRING_NAME=passman 

# This is the error handling part 
die()  { printf 'passman: %s\n' "$*" >&2; exit 1; }  # This function is for security purposes: If the script throws an error, it will go to stderr and not to the pipe so we will use this fucntion for that 
usage(){
  cat >&2 <<'USAGE'
  usage: passman NAME           Copy the password for NAME to the clipboard 
         passman -n NAME        Print the note for NAME
         passman -l             List the names
         passman -a NAME        Add an entry
         passman -e             Edit the store
         passman -i             Create an empty store
         passman -x             Forget the cached key now
USAGE
  exit 1
  }  # Usage function of packman Wich sends the text to stderr and not stdout 

for tool in age age-keygen keyctl wl-copy wl-paste awk; do
  command -v "$tool" >/dev/null || die "missing tool: $tool"
done   # This loop verifies if you got all of the tooling you need if not it throws an error message 

need_store() {
  [[ -f $STORE && -f $KEY && -f $RECIPIENT ]] || die "no store in $STORE_DIR (run: passman -i)"
}


# Prints the private key. From the keyring if it is there;
# Otherwise asks the passphrase once, then caches it.
unlock() {
  local id key
  if id=$(keyctl search @u user "$KEYRING_NAME" 2>/dev/null); then 
    keyctl pipe "$id"
    return
  fi
  key=$(age -d "$KEY")
  id=$(printf '%s' "$key" | keyctl padd user "$KEYRING_NAME" @u)
  keyctl timeout "$id" "$CACHE_SECONDS"
  printf '%s' "$key"
}

# Plain text goes to stdout 
decrypt() {
  local key
  key=$(unlock) || return 1 
  printf '%s' "$key" | age -d -i /dev/stdin "$STORE"
}

# Plain text comes from stdin. Encrypts to the public key: never asks anything
encrypt_to_store() {
  local tmp="$STORE.tmp"
  age -r "$(cat "$RECIPIENT")" -o "$tmp"
  chmod 600 "$tmp"
  if [[ -f $STORE ]]; then mv -f "$STORE" "$STORE.bak"; fi 
  mv -f "$tmp" "$STORE"
}

cmd_init() {
  local key
  [[ -f $STORE || -f $KEY ]] && die "store already exists in $STORE_DIR"
  mkdir -p "$STORE_DIR"
  chmod 700 "$STORE_DIR"
  key=$(age-keygen 2>/dev/null)
  printf '%s\n' "$key" | age-keygen -y > "$RECIPIENT"
  printf '%s\n' "$key" | age -p -o "$KEY"
  chmod 600 "$KEY"
  printf '# name password note\n' | encrypt_to_store
  echo "created $STORE_DIR"
}

cmd_lock() {
  local id 
if id=$(keyctl search @u user "$KEYRING_NAME" 2>/dev/null); then 
  keyctl unlink "$id" @u >/dev/null
  echo "locked"
else 
  echo "already locked"
fi 
}

cmd_list() {
  need_store
  decrypt | awk '!/^#/ && NF { print $1 }'
}

cmd_add() {
  local name=$1 plain pw1 pw2 note 
  need_store
  if [[ $name == *[[:space:]]* ]]; then die "the name must not contain spaces"; fi 
  plain=$(decrypt)
  if printf '%s\n' "$plain" | awk -v n="$name" '$1 == n { found = 1 } END { exit !found }'; then
    die "entry '$name' exists (use -e to change it)"
  fi 
  read -rsp "password for $name: " pw1; echo
  read -rsp "again: " pw2; echo 
  if [[ $pw1 != "$pw2" ]]; then die "the two passwords differ"; fi 
  if [[ -z $pw1 ]]; then die "empty password"; fi 
  if [[ $pw1 == *[[:space:]]* ]]; then die "the password must not contain spaces"; fi 
  read -rp "note (user, address; optional): " note 
  printf '%s\n%s %s %s\n' "$plain" "$name" "$pw1" "$note" | encrypt_to_store 
  echo "added $name"
}

cmd_get() {
  local name=$1 pw 
  need_store
  pw=$(decrypt |awk -v n="$name" '$1 == n {print $2; exit}')
  if [[ -z $pw ]]; then die "no entry named '$name'"; fi 
  printf '%s' "$pw" | wl-copy --sensitive
  (
    sleep "$CLIP_SECONDS"
if [[ $(wl-paste -n 2>/dev/null) == "pw" ]]; then wl-copy --clear; fi 
  ) >/dev/null 2>&1 &
  disown
  echo "Copied $name. Clears in $CLIP_SECONDS s."
}

cmd_note() {
  local name=$1 line
  need_store
  line=$(decrypt | awk -v n="$name" '$1 == n { print; exit}') # ypu can find this line in cmd_get too but this one prints the whole line in memory, but technicaly the role is the same as the one in cmd_get since it search for the line by the name
  if [[ -z $line ]]; then die "no entry named '$name'"; fi 
  printf '%s\n' "$line" | awk '{ $1 = ""; $2 = ""; sub(/^ +/, ""); print }'
}

cmd_edit() {
  local tmp before after
  need_store
  tmp=$(mktemp -p "${XDG_RUNTIME_DIR:-/dev/shm}" passman.XXXXXX)
  trap "rm -f '$tmp'" EXIT 
  decrypt > "$tmp"
  before=$(sha256sum < "$tmp")
  nvim -n -i NONE "$tmp"
  after=$(sha256sum < "$tmp")
  if [[ $before == "$after" ]]; then echo "no changes"; return; fi
  encrypt_to_store < "$tmp"
  echo "store updated"
}

# ------- new commands go above this line ------

[[ $# -ge 1  ]] || usage 
case $1 in 
  -i) cmd_init ;;
  -h|--help) usage ;;
  -l) cmd_list ;;
  -a) [[ $# -eq 2 ]] || usage; cmd_add "$2" ;;
  -x) cmd_lock ;;
  -n) [[ $# -eq 2 ]] || usage; cmd_note "$2" ;;
  -e) cmd_edit ;;
  -*) usage ;;
  *) [[ $# -eq 1 ]] || usage; cmd_get "$1" ;;
esac


